SMTP_PORT=587
SMTP_USER=campusconnect.reva@gmail.com
SMTP_PASS=your_app_specific_password
EMAIL_FROM=CampusConnect REVA <noreply.campusconnect@reva.edu.in>

# Application Base URL
APP_URL=http://localhost:5000

